<infra:ToolPage x:Class="NetStuff.Pages.WhoisPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Whois / RDAP" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Registrierungsdaten zu Domains, IP-Adressen und AS-Nummern – klassisch per Whois (mit automatischer Weiterleitung) oder modern per RDAP." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Domain, IP oder ASN (z. B. AS3320)" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="QueryBox" Text="example.com" Width="300" KeyDown="QueryBox_KeyDown" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Whois-Server (optional)" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="ServerBox" Width="200" PlaceholderText="automatisch" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                    <CheckBox x:Name="FollowBox" Content="Weiterleitungen folgen" IsChecked="True" />
                </StackPanel>
                <ui:Button x:Name="WhoisButton" Content="Whois" Style="{StaticResource PrimaryButton}" Click="Whois_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                <ui:Button x:Name="RdapButton" Content="RDAP" Click="Rdap_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" MinWidth="90" Height="34" />
                <ui:Button Content="Kopieren" Click="Copy_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" Height="34" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Zusammenfassung" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="SummaryList" ItemTemplate="{StaticResource CheckItemTemplate}" Focusable="False" />
            </StackPanel>
        </Border>

        <TextBox Grid.Row="3" x:Name="RawBox" Style="{StaticResource MonoOutput}" />
    </Grid>
</infra:ToolPage>
