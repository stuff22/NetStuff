<infra:ToolPage x:Class="NetStuff.Pages.DnsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="DNS-Checker" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Fragt DNS-Einträge direkt bei einem Resolver oder autoritativen Nameserver ab – inklusive TTL und DNSSEC-Status. Eine IP-Adresse wird automatisch per PTR aufgelöst." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Domain oder IP" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="NameBox" Text="example.com" Width="300" KeyDown="NameBox_KeyDown" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="DNS-Server" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ServerBox" IsEditable="True" Width="260" Text="System (Windows)">
                            <ComboBoxItem Content="System (Windows)" />
                            <ComboBoxItem Content="1.1.1.1 (Cloudflare)" />
                            <ComboBoxItem Content="8.8.8.8 (Google)" />
                            <ComboBoxItem Content="9.9.9.9 (Quad9)" />
                            <ComboBoxItem Content="Autoritativ (NS der Domain)" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                        <CheckBox x:Name="TcpBox" Content="Nur TCP" />
                    </StackPanel>
                    <ui:Button x:Name="QueryButton" Content="Abfragen" Style="{StaticResource PrimaryButton}" Click="Query_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    <ui:Button Content="Kopieren" Click="Copy_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" Height="34" />
                </WrapPanel>
                <WrapPanel x:Name="TypePanel" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="InfoText" Style="{StaticResource Muted}" Margin="2,0,0,8" />

        <DataGrid Grid.Row="3" x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="80" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                <DataGridTextColumn Header="TTL" Binding="{Binding TtlText}" SortMemberPath="Ttl" Width="140" />
                <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="*" MinWidth="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</infra:ToolPage>
