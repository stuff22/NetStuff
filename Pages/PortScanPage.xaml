<infra:ToolPage x:Class="NetStuff.Pages.PortScanPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Port-Scanner" Style="{StaticResource PageTitle}" />
            <TextBlock Text="TCP-Connect-Scan mit Dienst-Erkennung und Banner. Bitte nur eigene oder freigegebene Systeme scannen." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Host" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="HostBox" Width="240" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Vorlage" Style="{StaticResource Label}" />
                    <ComboBox x:Name="PresetBox" Width="190" SelectionChanged="PresetBox_SelectionChanged">
                        <ComboBoxItem Content="Top 100" IsSelected="True" />
                        <ComboBoxItem Content="Bekannte Dienste" />
                        <ComboBoxItem Content="1–1024" />
                        <ComboBoxItem Content="Alle (1–65535)" />
                        <ComboBoxItem Content="Benutzerdefiniert" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Ports (z. B. 22,80,443,8000-8100)" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="PortsBox" Width="280" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Timeout (ms)" Style="{StaticResource Label}" />
                    <ui:NumberBox x:Name="TimeoutBox" Value="800" Minimum="100" Maximum="10000" Width="150" SmallChange="100" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Parallel" Style="{StaticResource Label}" />
                    <ui:NumberBox x:Name="ParallelBox" Value="200" Minimum="1" Maximum="1000" Width="150" SmallChange="50" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                    <CheckBox x:Name="BannerBox" Content="Banner abrufen" IsChecked="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <ui:Button x:Name="StartButton" Content="Scannen" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                    <ui:Button x:Name="StopButton" Content="Stopp" Margin="8,0,0,0" MinWidth="90" Height="34" IsEnabled="False" Click="Stop_Click" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
            <ProgressBar x:Name="Progress" Height="4" VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid Grid.Row="3" x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
                <DataGridTextColumn Header="Dienst" Binding="{Binding Service}" Width="150" />
                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="90" />
                <DataGridTextColumn Header="Antwortzeit" Binding="{Binding Time}" Width="100" />
                <DataGridTextColumn Header="Banner / Antwort" Binding="{Binding Banner}" Width="*" MinWidth="200" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</infra:ToolPage>
