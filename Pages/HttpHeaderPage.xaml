<infra:ToolPage x:Class="NetStuff.Pages.HttpHeaderPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="HTTP-Header-Checker" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Zeigt Weiterleitungskette, alle Response-Header und bewertet Sicherheits-Header (HSTS, CSP, X-Frame-Options …) sowie Cookies." Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Card}">
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="URL" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="UrlBox" Text="https://example.com" Width="380" KeyDown="UrlBox_KeyDown" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Methode" Style="{StaticResource Label}" />
                        <ComboBox x:Name="MethodBox" Width="100" SelectedIndex="0">
                            <ComboBoxItem Content="GET" />
                            <ComboBoxItem Content="HEAD" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="User-Agent" Style="{StaticResource Label}" />
                        <ComboBox x:Name="UaBox" Width="150" SelectedIndex="0">
                            <ComboBoxItem Content="Browser (Chrome)" />
                            <ComboBoxItem Content="Smartphone" />
                            <ComboBoxItem Content="Googlebot" />
                            <ComboBoxItem Content="curl" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                        <CheckBox x:Name="FollowBox" Content="Weiterleitungen folgen" IsChecked="True" />
                    </StackPanel>
                    <ui:Button x:Name="CheckButton" Content="Prüfen" Style="{StaticResource PrimaryButton}" Click="Check_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    <ui:Button Content="Kopieren" Click="Copy_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" Height="34" />
                </WrapPanel>
            </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel" />
        </ScrollViewer>
    </DockPanel>
</infra:ToolPage>
