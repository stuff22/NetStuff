<infra:ToolPage x:Class="NetStuff.Pages.WlanSurveyPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="WLAN-Ausleuchtung" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Geh mit dem Laptop von Raum zu Raum und nimm jeweils einen Messpunkt auf: Signalstärke, verbundener Access Point, Kanal, Datenrate, Ping zum Gateway und optional der Durchsatz. Ergebnis als Tabelle für den Kundenbericht." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Raum / Messpunkt" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="RoomBox" Width="240" PlaceholderText="z. B. Büro 1. OG" KeyDown="RoomBox_KeyDown" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Notiz" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="NoteBox" Width="240" PlaceholderText="optional" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                    <CheckBox x:Name="SpeedBox" Content="Durchsatz messen (5 s)" IsChecked="True" />
                </StackPanel>
                <ui:Button x:Name="StartButton" Content="Messpunkt aufnehmen" Style="{StaticResource PrimaryButton}" Click="Measure_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                <ui:Button Content="Entfernen" Click="Remove_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" Height="34" />
                <ui:Button Content="Liste leeren" Click="Clear_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" Height="34" />
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource Muted}" Margin="2,0,0,8" />

        <DataGrid Grid.Row="3" x:Name="SurveyGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30" SortMemberPath="Rating">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Level, Converter={StaticResource LevelToGlyph}}" FontFamily="{StaticResource IconFont}"
                                       Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,2,0,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Raum" Binding="{Binding Room}" Width="150" />
                <DataGridTextColumn Header="Bewertung" Binding="{Binding Rating}" Width="90" />
                <DataGridTextColumn Header="Signal" Binding="{Binding RssiText}" Width="80" />
                <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="130" />
                <DataGridTextColumn Header="Access Point (BSSID)" Binding="{Binding Bssid}" Width="150" />
                <DataGridTextColumn Header="Kanal / Band" Binding="{Binding Channel}" Width="120" />
                <DataGridTextColumn Header="Datenrate" Binding="{Binding Rate}" Width="110" />
                <DataGridTextColumn Header="Ping GW" Binding="{Binding Ping}" Width="80" />
                <DataGridTextColumn Header="Durchsatz" Binding="{Binding Speed}" Width="100" />
                <DataGridTextColumn Header="APs gleiche SSID" Binding="{Binding SameSsid}" Width="120" />
                <DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="70" />
                <DataGridTextColumn Header="Notiz" Binding="{Binding Note}" Width="*" MinWidth="120" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Margin="2,8,0,0"
                   Text="Bewertung: Gut ≥ −60 dBm (alles möglich) · Mittel −60 bis −70 dBm (Surfen/Office) · Schwach −70 bis −80 dBm · Kritisch &lt; −80 dBm." />
    </Grid>
</infra:ToolPage>
