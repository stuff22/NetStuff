<infra:ToolPage x:Class="NetStuff.Pages.SubnetPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Subnetzrechner" Style="{StaticResource PageTitle}" />
            <TextBlock Text="IPv4 und IPv6: Netzadresse, Broadcast, Hostbereich, Maske, Wildcard und Aufteilung in Subnetze. Eingabe als CIDR (192.168.10.77/26) oder mit Maske (10.0.0.1 255.255.240.0)." Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Card}">
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Adresse / Netz" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="InputBox" Text="192.168.10.77/26" Width="320" TextChanged="Input_Changed" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Aufteilen in Präfix /" Style="{StaticResource Label}" />
                        <ui:NumberBox x:Name="SplitBox" Value="28" Minimum="1" Maximum="128" Width="150" />
                    </StackPanel>
                </WrapPanel>
            </Border>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultsPanel" />
            </ScrollViewer>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" x:Name="SplitTitle" Style="{StaticResource SectionTitle}" />
                <DataGrid x:Name="SplitGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" />
                        <DataGridTextColumn Header="Netz" Binding="{Binding Network}" Width="170" />
                        <DataGridTextColumn Header="Hostbereich" Binding="{Binding Hosts}" Width="*" MinWidth="240" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</infra:ToolPage>
