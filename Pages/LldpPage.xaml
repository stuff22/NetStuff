<infra:ToolPage x:Class="NetStuff.Pages.LldpPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="LLDP / CDP" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Zeigt, an welchem Switch, Port und VLAN dieser PC hängt – aus den LLDP- und CDP-Paketen, die Switches regelmäßig senden. Nutzt das Windows-Bordmittel pktmon (Administratorrechte werden einmal abgefragt)." Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <ui:Button x:Name="StartButton" Content="Mitschnitt starten" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                        <ui:Button x:Name="StopButton" Content="Abbrechen" Margin="8,0,0,0" MinWidth="90" Height="34" IsEnabled="False" Click="Stop_Click" />
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Dauer" Style="{StaticResource Label}" />
                            <ComboBox x:Name="DurationBox" Width="240" SelectedIndex="1">
                                <ComboBoxItem Content="35 Sekunden (nur LLDP)" Tag="35" />
                                <ComboBoxItem Content="65 Sekunden (LLDP + CDP)" Tag="65" />
                                <ComboBoxItem Content="125 Sekunden (sicher)" Tag="125" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Width="520" VerticalAlignment="Bottom"
                                   Text="Switches senden LLDP meist alle 30 s und CDP alle 60 s. Alternativ lassen sich die Nachbarn eines Switches im SNMP-Browser („LLDP-Nachbarn“) abfragen." />
                    </WrapPanel>
                </DockPanel>
            </Border>
            <DockPanel Margin="0,0,0,10">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <ProgressBar x:Name="Progress" Height="4" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel" />
        </ScrollViewer>
    </DockPanel>
</infra:ToolPage>
