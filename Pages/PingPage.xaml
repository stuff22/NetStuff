<infra:ToolPage x:Class="NetStuff.Pages.PingPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure"
                xmlns:ctl="clr-namespace:NetStuff.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Ping" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Dauerping auf ein oder mehrere Ziele parallel – mit Verlust, Jitter und Live-Verlauf." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Ziele (Hostname oder IP, durch Komma oder Zeilenumbruch getrennt)" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="TargetsBox" Text="8.8.8.8, 1.1.1.1" AcceptsReturn="True" Height="58" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <WrapPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Intervall (ms)" Style="{StaticResource Label}" />
                            <ui:NumberBox x:Name="IntervalBox" Value="1000" Minimum="100" Maximum="60000" Width="150" SmallChange="100" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Timeout (ms)" Style="{StaticResource Label}" />
                            <ui:NumberBox x:Name="TimeoutBox" Value="2000" Minimum="100" Maximum="10000" Width="150" SmallChange="100" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Größe (Bytes)" Style="{StaticResource Label}" />
                            <ui:NumberBox x:Name="SizeBox" Value="32" Minimum="0" Maximum="65500" Width="150" />
                        </StackPanel>
                    </WrapPanel>
                    <DockPanel Margin="0,10,0,0">
                        <CheckBox x:Name="DfBox" Content="Nicht fragmentieren (DF)" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button x:Name="StartButton" Content="Start" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                            <ui:Button x:Name="StopButton" Content="Stopp" Margin="8,0,0,0" MinWidth="90" Height="34" IsEnabled="False" Click="Stop_Click" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" x:Name="StatsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" MaxHeight="220" Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="28">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Ziel" Binding="{Binding Host}" Width="*" MinWidth="200" />
                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="140" />
                <DataGridTextColumn Header="Gesendet" Binding="{Binding Sent}" Width="80" />
                <DataGridTextColumn Header="Verlust" Binding="{Binding LossText}" Width="80" />
                <DataGridTextColumn Header="Letzter" Binding="{Binding LastText}" Width="80" />
                <DataGridTextColumn Header="Min" Binding="{Binding MinText}" Width="70" />
                <DataGridTextColumn Header="Ø" Binding="{Binding AvgText}" Width="70" />
                <DataGridTextColumn Header="Max" Binding="{Binding MaxText}" Width="70" />
                <DataGridTextColumn Header="Jitter" Binding="{Binding JitterText}" Width="70" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0" Padding="8">
            <ctl:LineChart x:Name="Chart" />
        </Border>
    </Grid>
</infra:ToolPage>
