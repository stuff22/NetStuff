<infra:ToolPage x:Class="NetStuff.Pages.ResolverPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Resolver-Vergleich" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Stellt dieselbe Anfrage an viele DNS-Resolver (klassisch und DNS-over-HTTPS) und vergleicht Antworten und Antwortzeiten – ideal, um DNS-Propagation, Filter oder Manipulation zu erkennen." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Name" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="NameBox" Text="example.com" Width="280" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Typ" Style="{StaticResource Label}" />
                    <ComboBox x:Name="TypeBox" Width="110" SelectedIndex="0">
                        <ComboBoxItem Content="A" />
                        <ComboBoxItem Content="AAAA" />
                        <ComboBoxItem Content="MX" />
                        <ComboBoxItem Content="NS" />
                        <ComboBoxItem Content="TXT" />
                        <ComboBoxItem Content="CNAME" />
                        <ComboBoxItem Content="SOA" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Wiederholungen" Style="{StaticResource Label}" />
                    <ui:NumberBox x:Name="RoundsBox" Value="3" Minimum="1" Maximum="20" Width="150" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Eigener Resolver (IP oder DoH-URL)" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="CustomBox" Width="220" PlaceholderText="z. B. 192.168.1.1" />
                        <ui:Button Content="Hinzufügen" Click="Add_Click" Margin="6,0,0,0" Height="34" />
                    </StackPanel>
                </StackPanel>
                <ui:Button x:Name="StartButton" Content="Vergleichen" Style="{StaticResource PrimaryButton}" Click="Start_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="InfoText" Style="{StaticResource Muted}" Margin="2,0,0,8" />

        <DataGrid Grid.Row="3" x:Name="ResultGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                <DataGridTextColumn Header="Resolver" Binding="{Binding Name}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="210" IsReadOnly="True" />
                <DataGridTextColumn Header="Ø ms" Binding="{Binding AvgText}" SortMemberPath="AvgSort" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="Min" Binding="{Binding MinText}" Width="60" IsReadOnly="True" />
                <DataGridTextColumn Header="Max" Binding="{Binding MaxText}" Width="60" IsReadOnly="True" />
                <DataGridTextColumn Header="TTL" Binding="{Binding Ttl}" Width="70" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Ergebnis" Width="160" SortMemberPath="Verdict">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Level, Converter={StaticResource LevelToGlyph}}" FontFamily="{StaticResource IconFont}"
                                           Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,2,6,0" />
                                <TextBlock Text="{Binding Verdict}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Antwort" Binding="{Binding Answer}" Width="*" MinWidth="200" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</infra:ToolPage>
