<infra:ToolPage x:Class="NetStuff.Pages.HistoryPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Verlauf &amp; Favoriten" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Favoriten speichern Sie mit dem Stern-Button oben in jedem Werkzeug. Doppelklick startet das Werkzeug mit dem gespeicherten Ziel erneut (Strg + Doppelklick: in neuem Tab)." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="Ausführen" Click="RunFav_Click" Height="32" />
                <ui:Button Content="Umbenennen" Click="RenameFav_Click" Height="32" Margin="6,0,0,0" />
                <ui:Button Content="Entfernen" Click="RemoveFav_Click" Height="32" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Text="★ Favoriten" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="2,0,0,0" />
        </DockPanel>
        <DataGrid Grid.Row="2" x:Name="FavGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                  SelectionMode="Single" MouseDoubleClick="FavGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="200" />
                <DataGridTextColumn Header="Werkzeug" Binding="{Binding ToolTitle}" Width="200" />
                <DataGridTextColumn Header="Ziel" Binding="{Binding Target}" Width="280" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,16,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:TextBox x:Name="FilterBox" Width="220" PlaceholderText="Verlauf filtern …" TextChanged="FilterBox_TextChanged" Margin="0,0,6,0" />
                <ui:Button Content="Ausführen" Click="RunHist_Click" Height="32" />
                <ui:Button Content="Als Favorit" Click="FavFromHist_Click" Height="32" Margin="6,0,0,0" />
                <ui:Button Content="Verlauf leeren" Click="ClearHist_Click" Height="32" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Text="Verlauf" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="2,0,0,0" />
        </DockPanel>
        <DataGrid Grid.Row="4" x:Name="HistGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                  SelectionMode="Single" MouseDoubleClick="HistGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="140" />
                <DataGridTextColumn Header="Werkzeug" Binding="{Binding ToolTitle}" Width="200" />
                <DataGridTextColumn Header="Ziel" Binding="{Binding Target}" Width="*" MinWidth="200" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</infra:ToolPage>
