<infra:ToolPage x:Class="NetStuff.Pages.SiteCopyPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Website-Kopierer" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Lädt eine Website komplett herunter, behält die Ordnerstruktur des Webservers bei und schreibt die Links um, sodass die Kopie offline im Browser funktioniert. Fremde Domains werden nur nach Rückfrage geladen. Bitte nur eigene oder freigegebene Websites kopieren." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Eingabe -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Start-URL" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="UrlBox" Width="360" PlaceholderText="https://www.example.com" KeyDown="UrlBox_KeyDown" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Zielordner (je Website ein Unterordner)" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox x:Name="FolderBox" Width="320" />
                            <ui:Button Click="Browse_Click" Margin="6,0,0,0" Height="34" ToolTip="Ordner wählen">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8DA;" Margin="0,2,0,0" />
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <ui:Button x:Name="StartButton" Content="Kopieren" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                        <ui:Button x:Name="StopButton" Content="Stopp" Margin="8,0,0,0" MinWidth="90" Height="34" IsEnabled="False" Click="Stop_Click" />
                        <ui:Button x:Name="OpenOfflineButton" Margin="8,0,0,0" Height="34" IsEnabled="False" Click="OpenOffline_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" Margin="0,2,8,0" />
                                <TextBlock Text="Offline öffnen" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="OpenFolderButton" Margin="8,0,0,0" Height="34" IsEnabled="False" Click="OpenFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" Margin="0,2,8,0" />
                                <TextBlock Text="Ordner öffnen" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </WrapPanel>

                <Expander Header="Optionen" Margin="0,2,0,0">
                    <WrapPanel Margin="0,8,0,0">
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Linktiefe" Style="{StaticResource Label}" />
                            <ui:NumberBox x:Name="DepthBox" Value="5" Minimum="0" Maximum="50" Width="130" SmallChange="1" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Max. Dateien (0 = alle)" Style="{StaticResource Label}" />
                            <ui:NumberBox x:Name="MaxFilesBox" Value="5000" Minimum="0" Maximum="1000000" Width="160" SmallChange="500" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Max. Dateigröße MB (0 = ∞)" Style="{StaticResource Label}" />
                            <ui:NumberBox x:Name="MaxSizeBox" Value="100" Minimum="0" Maximum="100000" Width="160" SmallChange="10" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Parallel" Style="{StaticResource Label}" />
                            <ui:NumberBox x:Name="ParallelBox" Value="4" Minimum="1" Maximum="16" Width="120" SmallChange="1" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Pause je Anfrage (ms)" Style="{StaticResource Label}" />
                            <ui:NumberBox x:Name="DelayBox" Value="0" Minimum="0" Maximum="10000" Width="150" SmallChange="100" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Fremde Domains" Style="{StaticResource Label}" />
                            <ComboBox x:Name="ForeignBox" Width="300">
                                <ComboBoxItem Content="Immer nachfragen" IsSelected="True" />
                                <ComboBoxItem Content="Ressourcen automatisch, Seiten nachfragen" />
                                <ComboBoxItem Content="Nie laden" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Ausschließen (Endungen, z. B. mp4,zip,iso)" Style="{StaticResource Label}" />
                            <ui:TextBox x:Name="ExcludeBox" Width="260" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                            <CheckBox x:Name="SubdomainsBox" Content="Subdomains der Start-Domain einbeziehen" IsChecked="True" />
                            <CheckBox x:Name="BelowBox" Content="Nur unterhalb des Start-Verzeichnisses" />
                            <CheckBox x:Name="RobotsBox" Content="robots.txt beachten" IsChecked="True" />
                        </StackPanel>
                    </WrapPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Fortschritt -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
            <ProgressBar x:Name="Progress" Height="4" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Rückfrage fremde Domains -->
        <Border Grid.Row="3" x:Name="ForeignCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="Alle erlauben" Click="AllowAll_Click" Height="30" />
                        <ui:Button Content="Alle ablehnen" Click="DenyAll_Click" Height="30" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Fremde Domains" Style="{StaticResource SectionTitle}" Margin="0" />
                        <TextBlock x:Name="ForeignHint" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Die Website verweist auf andere Domains. Sollen Inhalte von dort mitgeladen werden? Erlaubt werden Ressourcen (Bilder, CSS, Skripte, Schriften) und direkt verlinkte Seiten geladen – fremde Seiten werden nicht weiterverfolgt." />
                    </StackPanel>
                </DockPanel>
                <Border x:Name="WaitBanner" Visibility="Collapsed" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" Background="#33D29922">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="#D29922" Margin="0,2,8,0" />
                        <TextBlock Text="Der Download ist pausiert und wartet auf Ihre Entscheidung zu den offenen Domains." FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl x:Name="ForeignList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                        <ui:Button Content="Erlauben" Tag="{Binding Host}" Click="Allow_Click" Height="28" Padding="10,0" />
                                        <ui:Button Content="Ablehnen" Tag="{Binding Host}" Click="Deny_Click" Height="28" Padding="10,0" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Host}" FontWeight="SemiBold" Width="300" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Width="190" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding DecisionText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Zusammenfassung -->
        <StackPanel Grid.Row="4" x:Name="SummaryPanel" />

        <!-- Protokoll -->
        <DockPanel Grid.Row="5">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <CheckBox x:Name="ErrorsOnlyBox" DockPanel.Dock="Right" Content="Nur Fehler anzeigen" Checked="ErrorsOnly_Changed" Unchecked="ErrorsOnly_Changed" />
                <TextBlock Text="Protokoll" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                    <DataGridTextColumn Header="Typ" Binding="{Binding Kind}" Width="95" />
                    <DataGridTextColumn Header="Größe" Binding="{Binding Size}" Width="80" />
                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" MinWidth="200" />
                    <DataGridTextColumn Header="Lokale Datei / Hinweis" Binding="{Binding LocalFile}" Width="*" MinWidth="160" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</infra:ToolPage>
