<infra:ToolPage x:Class="NetStuff.Pages.MonitorPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure"
                xmlns:ctl="clr-namespace:NetStuff.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Überwachung" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Prüft Hosts und Dienste dauerhaft im Hintergrund (Ping, TCP-Port, HTTP, DNS, TLS-Zertifikat) und meldet Ausfälle per Windows-Benachrichtigung – auch wenn dieser Tab geschlossen ist." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Name" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="NameInput" Width="170" PlaceholderText="z. B. Firewall" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Typ" Style="{StaticResource Label}" />
                    <ComboBox x:Name="TypeBox" Width="160" SelectedIndex="0" SelectionChanged="TypeBox_SelectionChanged">
                        <ComboBoxItem Content="Ping" />
                        <ComboBoxItem Content="TCP" />
                        <ComboBoxItem Content="HTTP" />
                        <ComboBoxItem Content="DNS" />
                        <ComboBoxItem Content="TLS" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Ziel (Host, IP oder URL)" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="TargetBox" Width="240" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8" x:Name="PortPanel" Visibility="Collapsed">
                    <TextBlock Text="Port" Style="{StaticResource Label}" />
                    <ui:NumberBox x:Name="PortBox" Value="443" Minimum="1" Maximum="65535" Width="140" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Intervall (s)" Style="{StaticResource Label}" />
                    <ui:NumberBox x:Name="IntervalBox" Value="30" Minimum="5" Maximum="3600" Width="140" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Alarm nach Fehlern" Style="{StaticResource Label}" />
                    <ui:NumberBox x:Name="ThresholdBox" Value="3" Minimum="1" Maximum="20" Width="140" />
                </StackPanel>
                <ui:Button Content="Hinzufügen" Click="Add_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" Height="34" />
            </WrapPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <ui:Button x:Name="StartButton" Content="Überwachung starten" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                <ui:Button x:Name="StopButton" Content="Stoppen" Margin="8,0,0,0" MinWidth="90" Height="34" Click="Stop_Click" />
                <ui:Button Content="Entfernen" Margin="8,0,0,0" Height="34" Click="Remove_Click" />
                <ui:Button Content="Jetzt prüfen" Margin="8,0,0,0" Height="34" Click="CheckNow_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="TargetGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                      SelectionMode="Single" SelectionChanged="TargetGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Status}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
                    <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="60" />
                    <DataGridTextColumn Header="Ziel" Binding="{Binding Display}" Width="170" />
                    <DataGridTextColumn Header="Letztes Ergebnis" Binding="{Binding LastValue}" Width="*" MinWidth="180" />
                    <DataGridTextColumn Header="Verfügbarkeit" Binding="{Binding Availability}" Width="100" />
                    <DataGridTextColumn Header="Geprüft" Binding="{Binding LastCheck}" Width="80" />
                    <DataGridTextColumn Header="Seit" Binding="{Binding Since}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="8">
                <ctl:LineChart x:Name="Chart" MaxPoints="120" />
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Text="Ereignisprotokoll" Style="{StaticResource SectionTitle}" Margin="2,12,0,6" />
        <DataGrid Grid.Row="5" x:Name="EventGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Level, Converter={StaticResource LevelToGlyph}}" FontFamily="{StaticResource IconFont}"
                                       Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,2,0,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="130" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                <DataGridTextColumn Header="Ereignis" Binding="{Binding Message}" Width="*" MinWidth="200" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</infra:ToolPage>
