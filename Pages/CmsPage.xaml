<infra:ToolPage x:Class="NetStuff.Pages.CmsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="CMS-Checker" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Erkennt Content-Management-System, Shopsystem, Baukasten, Frameworks, Webserver, CDN und Tracking-Dienste einer Website – bei WordPress inklusive sichtbarer Plugins und Themes." Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Card}">
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Website" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="UrlBox" Text="https://wordpress.org" Width="380" KeyDown="UrlBox_KeyDown" />
                    </StackPanel>
                    <ui:Button x:Name="CheckButton" Content="Analysieren" Style="{StaticResource PrimaryButton}" Click="Check_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    <ui:Button Content="Kopieren" Click="Copy_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" Height="34" />
                </WrapPanel>
            </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="MainCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Erkanntes System" Style="{StaticResource Label}" />
                        <TextBlock x:Name="MainText" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="MainSub" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <DataGrid x:Name="DetectGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                          Visibility="Collapsed" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Technologie" Binding="{Binding Name}" Width="190" />
                        <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="120" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                        <DataGridTextColumn Header="Sicherheit" Binding="{Binding ConfidenceText}" Width="110" />
                        <DataGridTextColumn Header="Hinweise" Binding="{Binding EvidenceText}" Width="*" MinWidth="200" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="WpOffer" Style="{StaticResource Card}" Visibility="Collapsed">
                    <DockPanel>
                        <ui:Button x:Name="WpButton" DockPanel.Dock="Right" Content="wp-json auswerten" Style="{StaticResource PrimaryButton}" Click="WpJson_Click" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="WpOfferTitle" FontWeight="SemiBold" />
                            <TextBlock x:Name="WpOfferText" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <StackPanel x:Name="WpPanel" />
                <StackPanel x:Name="ResultsPanel" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</infra:ToolPage>
