<infra:ToolPage x:Class="NetStuff.Pages.NetScanPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Netzwerkscanner" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Findet Geräte im lokalen Netz per ARP und Ping und ermittelt Hostname, MAC-Hersteller, Gerätetyp und offene Dienste (NetBIOS, UPnP/SSDP, Port-Check)." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Bereich (CIDR, a-b oder Einzel-IP)" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="RangeBox" Width="260" />
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Ping-Timeout (ms)" Style="{StaticResource Label}" />
                    <ui:NumberBox x:Name="TimeoutBox" Value="700" Minimum="100" Maximum="5000" Width="150" SmallChange="100" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                    <CheckBox x:Name="PortsBox" Content="Gängige Ports prüfen (Typ-Erkennung)" IsChecked="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <ui:Button x:Name="StartButton" Content="Scannen" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                    <ui:Button x:Name="StopButton" Content="Stopp" Margin="8,0,0,0" MinWidth="90" Height="34" IsEnabled="False" Click="Stop_Click" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
            <ProgressBar x:Name="Progress" Height="4" VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid Grid.Row="3" x:Name="HostGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" SelectionMode="Single" MouseDoubleClick="HostGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="IP-Adresse" Binding="{Binding Ip}" SortMemberPath="SortKey" Width="110" />
                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="160" />
                <DataGridTextColumn Header="MAC-Adresse" Binding="{Binding Mac}" Width="150" />
                <DataGridTextColumn Header="Hersteller" Binding="{Binding Vendor}" Width="170" />
                <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="170" />
                <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" SortMemberPath="PingSort" Width="70" />
                <DataGridTextColumn Header="Offene Ports" Binding="{Binding Ports}" Width="220" />
                <DataGridTextColumn Header="Info (UPnP / NetBIOS)" Binding="{Binding Info}" Width="*" MinWidth="220" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Port-Scan" Click="PortScan_Click" />
                    <MenuItem Header="Ping" Click="Ping_Click" />
                    <MenuItem Header="Im Browser öffnen (http)" Click="OpenHttp_Click" />
                    <MenuItem Header="Im Browser öffnen (https)" Click="OpenHttps_Click" />
                    <MenuItem Header="Wake-on-LAN-Gerät anlegen" Click="Wol_Click" />
                    <Separator />
                    <MenuItem Header="IP kopieren" Click="CopyIp_Click" />
                    <MenuItem Header="MAC kopieren" Click="CopyMac_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="OuiText" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Herstellerliste aktualisieren" Click="UpdateOui_Click" Margin="0,0,8,0" />
                <ui:Button Content="Als CSV exportieren" Click="Export_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</infra:ToolPage>
