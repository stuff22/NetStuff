<infra:ToolPage x:Class="NetStuff.Pages.WolPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Wake-on-LAN" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Weckt Geräte per Magic Packet auf. Gespeicherte Geräte lassen sich mit einem Doppelklick starten." Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Card}">
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Name" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="NameBox" Width="180" PlaceholderText="z. B. Büro-PC" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="MAC-Adresse" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="MacBox" Width="190" PlaceholderText="AA:BB:CC:DD:EE:FF" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Ziel (Broadcast oder Host)" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="TargetBox" Width="190" Text="255.255.255.255" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Port" Style="{StaticResource Label}" />
                        <ui:NumberBox x:Name="PortBox" Value="9" Minimum="1" Maximum="65535" Width="150" />
                    </StackPanel>
                    <ui:Button Content="Aufwecken" Style="{StaticResource PrimaryButton}" Click="Wake_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    <ui:Button Content="Speichern" Click="Save_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" Height="34" />
                </WrapPanel>
            </Border>
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="2,0,0,10" />
        </StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <ui:Button Content="Ausgewähltes aufwecken" Click="WakeSelected_Click" />
                <ui:Button Content="Entfernen" Click="Remove_Click" Margin="8,0,0,0" />
            </StackPanel>
            <DataGrid x:Name="DeviceGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                      SelectionMode="Single" MouseDoubleClick="DeviceGrid_MouseDoubleClick" SelectionChanged="DeviceGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="200" />
                    <DataGridTextColumn Header="MAC-Adresse" Binding="{Binding Mac}" Width="170" />
                    <DataGridTextColumn Header="Ziel" Binding="{Binding Target}" Width="170" />
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</infra:ToolPage>
