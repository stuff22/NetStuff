<infra:ToolPage x:Class="NetStuff.Pages.DiskUsagePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <infra:ToolPage.Resources>
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="Im Explorer zeigen" Click="Reveal_Click" />
            <MenuItem Header="Pfad kopieren" Click="CopyPath_Click" />
        </ContextMenu>
        <DataTemplate x:Key="PercentCell">
            <Grid Margin="4,0">
                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="14" Opacity="0.55" />
                <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
            </Grid>
        </DataTemplate>
    </infra:ToolPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Speicher-Checker" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Zeigt wie TreeSize, welche Ordner und Dateien den meisten Platz belegen – auf lokalen Laufwerken, USB-Datenträgern und Netzwerkfreigaben. Findet Aufräum-Kandidaten wie Papierkorb, Caches, alte Installer, uralte Dateien und Duplikate." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Eingabe -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Ordner, Laufwerk oder Freigabe" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox x:Name="TargetBox" Width="420" PlaceholderText="C:\  ·  D:\Daten  ·  \\server\freigabe" KeyDown="TargetBox_KeyDown" />
                            <ui:Button Click="Browse_Click" Margin="6,0,0,0" Height="34" ToolTip="Ordner wählen">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8DA;" Margin="0,2,0,0" />
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <ui:Button x:Name="StartButton" Content="Analysieren" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                        <ui:Button x:Name="StopButton" Content="Stopp" Margin="8,0,0,0" MinWidth="90" Height="34" IsEnabled="False" Click="Stop_Click" />
                        <ui:Button x:Name="CopyButton" Content="Kopieren" Margin="8,0,0,0" Height="34" IsEnabled="False" Click="Copy_Click" />
                        <ui:Button x:Name="CsvButton" Content="CSV exportieren" Margin="8,0,0,0" Height="34" IsEnabled="False" Click="Csv_Click" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Schnellauswahl" Style="{StaticResource Label}" Margin="0,4,0,4" />
                <WrapPanel x:Name="LocationsPanel" />
                <TextBlock x:Name="NetworkHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Netzwerkfreigaben: UNC-Pfad wie \\server\freigabe eingeben oder ein verbundenes Netzlaufwerk wählen. Über das Netzwerk dauert der Scan länger – Unterordner werden parallel gelesen." />
            </StackPanel>
        </Border>

        <!-- Fortschritt -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="700" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="Progress" Height="4" VerticalAlignment="Center" />
        </DockPanel>

        <TabControl Grid.Row="3" x:Name="Tabs" IsEnabled="False">
            <!-- Übersicht -->
            <TabItem Header="Übersicht">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,8,0">
                    <StackPanel x:Name="SummaryPanel" />
                </ScrollViewer>
            </TabItem>

            <!-- Ordnerbaum + Inhalt -->
            <TabItem Header="Ordner">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" MinWidth="200" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TreeView x:Name="FolderTree" SelectedItemChanged="FolderTree_SelectedItemChanged"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding SubFolders}">
                                <Grid ToolTip="{Binding FullPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="10" Width="40" VerticalAlignment="Center" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{Binding TreeText}" VerticalAlignment="Center" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="Nach oben" Click="Up_Click" Height="30" />
                                <ui:Button Content="Im Explorer zeigen" Click="RevealCurrent_Click" Height="30" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="CurrentPathText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DataGrid x:Name="ContentGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  MouseDoubleClick="ContentGrid_DoubleClick" ContextMenu="{StaticResource RowMenu}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Binding="{Binding Icon}" Width="34" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="180" />
                                <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" SortMemberPath="Size" Width="95" />
                                <DataGridTemplateColumn Header="Anteil" CellTemplate="{StaticResource PercentCell}" SortMemberPath="Size" Width="110" />
                                <DataGridTextColumn Header="Dateien" Binding="{Binding FilesText}" SortMemberPath="Files" Width="85" />
                                <DataGridTextColumn Header="Geändert" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="95" />
                                <DataGridTextColumn Header="Typ" Binding="{Binding TypeText}" Width="*" MinWidth="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Größte Dateien -->
            <TabItem Header="Größte Dateien">
                <DataGrid x:Name="LargestGrid" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="Grid_DoubleClick" ContextMenu="{StaticResource RowMenu}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" SortMemberPath="Size" Width="95" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="Ordner" Binding="{Binding FolderPath}" Width="2*" MinWidth="200" />
                        <DataGridTextColumn Header="Geändert" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="95" />
                        <DataGridTextColumn Header="Typ" Binding="{Binding TypeText}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Dateitypen -->
            <TabItem Header="Dateitypen">
                <DataGrid x:Name="TypesGrid" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Endung" Binding="{Binding ExtensionText}" Width="140" />
                        <DataGridTextColumn Header="Kategorie" Binding="{Binding CategoryText}" Width="200" />
                        <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" SortMemberPath="Size" Width="95" />
                        <DataGridTemplateColumn Header="Anteil" CellTemplate="{StaticResource PercentCell}" SortMemberPath="Size" Width="130" />
                        <DataGridTextColumn Header="Dateien" Binding="{Binding CountText}" SortMemberPath="Count" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Alte Dateien -->
            <TabItem Header="Alte Dateien">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Nicht geändert seit mehr als" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="YearsBox" Width="120" SelectionChanged="Years_Changed">
                            <ComboBoxItem Content="1 Jahr" Tag="1" />
                            <ComboBoxItem Content="2 Jahren" Tag="2" IsSelected="True" />
                            <ComboBoxItem Content="3 Jahren" Tag="3" />
                            <ComboBoxItem Content="5 Jahren" Tag="5" />
                            <ComboBoxItem Content="10 Jahren" Tag="10" />
                        </ComboBox>
                        <TextBlock x:Name="OldSummary" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                    <DataGrid x:Name="OldGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="Grid_DoubleClick" ContextMenu="{StaticResource RowMenu}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" SortMemberPath="Size" Width="95" />
                            <DataGridTextColumn Header="Geändert" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="95" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="180" />
                            <DataGridTextColumn Header="Ordner" Binding="{Binding FolderPath}" Width="2*" MinWidth="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Duplikate -->
            <TabItem Header="Duplikate">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Dateien ab" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="MinSizeBox" Width="110">
                                <ComboBoxItem Content="100 KB" Tag="102400" />
                                <ComboBoxItem Content="1 MB" Tag="1048576" IsSelected="True" />
                                <ComboBoxItem Content="10 MB" Tag="10485760" />
                                <ComboBoxItem Content="100 MB" Tag="104857600" />
                            </ComboBox>
                            <ui:Button x:Name="DupButton" Content="Duplikate suchen" Margin="8,0,0,0" Height="34" Click="Dup_Click" />
                            <TextBlock x:Name="DupStatus" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Vergleicht den Inhalt (SHA-256), nicht nur Name und Größe. Dateien gleicher Größe werden dafür gelesen – auf Netzlaufwerken kann das dauern. Nur-Cloud-Dateien werden übersprungen." />
                    </StackPanel>
                    <DataGrid x:Name="DupGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="Grid_DoubleClick" ContextMenu="{StaticResource RowMenu}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Verschwendet" Binding="{Binding WastedText}" SortMemberPath="Wasted" Width="110" />
                            <DataGridTextColumn Header="Je Datei" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" />
                            <DataGridTextColumn Header="Anzahl" Binding="{Binding CountText}" Width="70" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="Fundorte" Binding="{Binding PathsText}" Width="2*" MinWidth="240" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</infra:ToolPage>
