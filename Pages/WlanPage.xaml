<infra:ToolPage x:Class="NetStuff.Pages.WlanPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure"
                xmlns:ctl="clr-namespace:NetStuff.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="WLAN-Scanner" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Alle Access Points in Reichweite mit Signalstärke, Kanal, Kanalbreite, Standard und Verschlüsselung – live als Spektrum." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ui:Button x:Name="StartButton" Content="Live-Scan starten" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                    <ui:Button x:Name="StopButton" Content="Stopp" Margin="8,0,0,0" MinWidth="90" Height="34" IsEnabled="False" Click="Stop_Click" />
                </StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="WLAN-Adapter" Style="{StaticResource Label}" />
                        <ComboBox x:Name="IfaceBox" Width="320" DisplayMemberPath="Description" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Band" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Band24" Content="2,4 GHz" GroupName="band" IsChecked="True" Checked="Band_Checked" Margin="0,0,8,0" />
                            <RadioButton x:Name="Band5" Content="5 GHz" GroupName="band" Checked="Band_Checked" Margin="0,0,8,0" />
                            <RadioButton x:Name="Band6" Content="6 GHz" GroupName="band" Checked="Band_Checked" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" x:Name="PermissionPanel" Style="{StaticResource Card}" Visibility="Collapsed"
                BorderBrush="#D29922">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Standort-Einstellungen öffnen" Click="OpenLocation_Click" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="Standortzugriff erforderlich" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Muted}" Text="Windows 11 gibt WLAN-Scanergebnisse nur frei, wenn die Standortdienste aktiv sind und Desktop-Apps darauf zugreifen dürfen: Einstellungen → Datenschutz und Sicherheit → Standort → „Standortdienste“ und „Desktop-Apps Zugriff auf Ihren Standort erlauben“ einschalten." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <ctl:SpectrumChart x:Name="Spectrum" />
        </Border>

        <DockPanel Grid.Row="4" Margin="2,0,0,8">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Style="{StaticResource Muted}" />
            <TextBlock x:Name="AdviceText" Style="{StaticResource Muted}" FontWeight="SemiBold" />
        </DockPanel>

        <DataGrid Grid.Row="5" x:Name="NetGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" SelectionMode="Single" SelectionChanged="NetGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="26">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="170" />
                <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid}" Width="140" />
                <DataGridTextColumn Header="Hersteller" Binding="{Binding Vendor}" Width="150" />
                <DataGridTextColumn Header="Signal" Binding="{Binding RssiText}" SortMemberPath="Rssi" Width="80" />
                <DataGridTemplateColumn Header="Qualität" Width="100" SortMemberPath="Quality">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding Quality, Mode=OneWay}" Maximum="100" Height="6" Margin="0,0,8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Kanal" Binding="{Binding Channel}" Width="60" />
                <DataGridTextColumn Header="Breite" Binding="{Binding WidthText}" SortMemberPath="Width" Width="85" />
                <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="75" />
                <DataGridTextColumn Header="Standard" Binding="{Binding Standard}" Width="120" />
                <DataGridTextColumn Header="Sicherheit" Binding="{Binding Security}" Width="160" />
                <DataGridTextColumn Header="Basisrate" Binding="{Binding RateText}" Width="90" />
                <DataGridTextColumn Header="" Binding="{Binding ConnectedText}" Width="*" MinWidth="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</infra:ToolPage>
