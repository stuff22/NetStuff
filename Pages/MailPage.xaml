<infra:ToolPage x:Class="NetStuff.Pages.MailPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Mail-Check" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Prüft die E-Mail-Konfiguration einer Domain: MX, SPF, DMARC, DKIM, MTA-STS, TLS-RPT, BIMI sowie die SMTP-Erreichbarkeit mit STARTTLS." Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Card}">
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Domain" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="DomainBox" Width="260" KeyDown="DomainBox_KeyDown" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="DKIM-Selektoren (kommagetrennt)" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="SelectorBox" Width="360"
                                    Text="default, selector1, selector2, google, k1, k2, s1, s2, mail, dkim, smtp, mx, key1, mandrill, everlytic, sig1, 2024, 2025" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                        <CheckBox x:Name="SmtpBox" Content="SMTP-Server testen (Port 25)" IsChecked="True" />
                    </StackPanel>
                    <ui:Button x:Name="CheckButton" Content="Prüfen" Style="{StaticResource PrimaryButton}" Click="Check_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    <ui:Button Content="Kopieren" Click="Copy_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" Height="34" />
                </WrapPanel>
            </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel" />
        </ScrollViewer>
    </DockPanel>
</infra:ToolPage>
