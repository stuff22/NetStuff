<infra:ToolPage x:Class="NetStuff.Pages.PathMtuPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Path-MTU" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Ermittelt die größte Paketgröße, die ohne Fragmentierung bis zum Ziel durchkommt (Ping mit gesetztem DF-Bit, binäre Suche)." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Ziel" Style="{StaticResource Label}" />
                    <ui:TextBox x:Name="TargetBox" Text="8.8.8.8" Width="300" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Max. MTU" Style="{StaticResource Label}" />
                    <ui:NumberBox x:Name="MaxBox" Value="1500" Minimum="576" Maximum="9216" Width="150" SmallChange="10" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Bottom">
                    <CheckBox x:Name="V6Box" Content="IPv6" />
                </StackPanel>
                <ui:Button x:Name="StartButton" Content="Ermitteln" Style="{StaticResource PrimaryButton}" Click="Start_Click" VerticalAlignment="Bottom" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Path-MTU" Style="{StaticResource Label}" />
                    <TextBlock x:Name="ResultText" Text="–" FontSize="40" FontWeight="SemiBold" />
                    <TextBlock x:Name="ResultSub" Style="{StaticResource Muted}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" LineHeight="20">
                    Typische Werte: <Bold>1500</Bold> Ethernet · <Bold>1492</Bold> PPPoE (DSL) · <Bold>1480</Bold> IPv6-in-IPv4 · <Bold>1476</Bold> GRE ·
                    <Bold>1420</Bold> WireGuard · <Bold>~1400</Bold> IPsec/OpenVPN · <Bold>9000</Bold> Jumbo-Frames.<LineBreak />
                    TCP-MSS = MTU − 40 (IPv4) bzw. − 60 (IPv6). Zeitüberschreitungen werden als „zu groß“ gewertet –
                    filtert das Ziel ICMP, kann das Ergebnis zu niedrig sein.
                </TextBlock>
            </Grid>
        </Border>

        <TextBox Grid.Row="3" x:Name="LogBox" Style="{StaticResource MonoOutput}" />
    </Grid>
</infra:ToolPage>
