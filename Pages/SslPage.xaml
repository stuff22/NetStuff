<infra:ToolPage x:Class="NetStuff.Pages.SslPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="SSL/TLS-Checker" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Analysiert Zertifikat, Zertifikatskette, Laufzeit, Protokollversionen und Verschlüsselung eines TLS-Dienstes (HTTPS, aber auch IMAPS, SMTPS, LDAPS …)." Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Card}">
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Host" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="HostBox" Text="example.com" Width="300" KeyDown="HostBox_KeyDown" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Port" Style="{StaticResource Label}" />
                        <ui:NumberBox x:Name="PortBox" Value="443" Minimum="1" Maximum="65535" Width="150" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="SNI (optional)" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="SniBox" Width="200" PlaceholderText="wie Host" />
                    </StackPanel>
                    <ui:Button x:Name="CheckButton" Content="Prüfen" Style="{StaticResource PrimaryButton}" Click="Check_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    <ui:Button Content="Kopieren" Click="Copy_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" Height="34" />
                </WrapPanel>
            </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel" />
        </ScrollViewer>
    </DockPanel>
</infra:ToolPage>
