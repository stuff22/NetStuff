<infra:ToolPage x:Class="NetStuff.Pages.DomainCheckPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:infra="clr-namespace:NetStuff.Infrastructure">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Domain-Check" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Alle wichtigen DNS-Prüfungen auf einmal: Delegation, Nameserver-Erreichbarkeit und Konsistenz, SOA-Werte, DNSSEC-Kette, Web/IPv6, Mail-Grundlagen, CAA, Blacklists und weltweite DNS-Propagation." Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Card}">
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Domain" Style="{StaticResource Label}" />
                        <ui:TextBox x:Name="DomainBox" Width="320" KeyDown="DomainBox_KeyDown" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                        <CheckBox x:Name="BlacklistBox" Content="Blacklists prüfen" IsChecked="True" />
                    </StackPanel>
                    <ui:Button x:Name="CheckButton" Content="Prüfen" Style="{StaticResource PrimaryButton}" Click="Check_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    <ui:Button Content="Kopieren" Click="Copy_Click" VerticalAlignment="Bottom" Margin="8,0,0,8" Height="34" />
                </WrapPanel>
            </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResultsPanel" />
        </ScrollViewer>
    </DockPanel>
</infra:ToolPage>
