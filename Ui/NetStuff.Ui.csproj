<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gemeinsame Avalonia-Oberfläche von Net-Stuff (macOS, Windows, später iPhone/iPad).
       Startprojekte: Desktop\ (macOS/Windows), später iOS\. Logik kommt aus Core\. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>NetStuff.Ui</RootNamespace>
    <AssemblyName>NetStuff.Ui</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\NetStuff.Core.csproj" />
  </ItemGroup>

</Project>
