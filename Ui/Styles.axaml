<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Gemeinsame Stile (Gegenstück zu App.xaml der WPF-App) -->
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.PageSubtitle">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style Selector="TextBlock.Label">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.Status">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="2,0,0,10" />
    </Style>
    <Style Selector="TextBlock.NavGroup">
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="12,14,0,4" />
    </Style>
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Button">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="Width" Value="140" />
        <Setter Property="FormatString" Value="0" />
    </Style>
    <!-- Kompakt (iPhone, schmale Fenster): feste Feldbreiten begrenzen -->
    <Style Selector="UserControl.compact TextBox">
        <Setter Property="MaxWidth" Value="320" />
    </Style>
    <Style Selector="UserControl.compact ComboBox">
        <Setter Property="MaxWidth" Value="320" />
    </Style>
    <Style Selector="UserControl.compact Button">
        <Setter Property="MinWidth" Value="64" />
    </Style>
    <Style Selector="UserControl.compact CheckBox">
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="UserControl.compact TextBlock.PageTitle">
        <Setter Property="FontSize" Value="24" />
    </Style>
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="True" />
    </Style>
</Styles>
