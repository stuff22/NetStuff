<l:ToolView xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:l="using:NetStuff.Ui.Infrastructure"
            xmlns:v="using:NetStuff.Ui.Views"
            xmlns:s="using:NetStuff.Services"
            x:Class="NetStuff.Ui.Views.CmsView">
    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel>
            <TextBlock Classes="PageTitle" Text="CMS-Checker" />
            <TextBlock Classes="PageSubtitle" Text="{l:T 'Erkennt Content-Management-System, Shopsystem, Baukasten, Frameworks, Webserver, CDN und Tracking-Dienste einer Website – bei WordPress inklusive sichtbarer Plugins und Themes.'}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="Card">
            <WrapPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Classes="Label" Text="{l:T 'Website'}" />
                    <TextBox x:Name="UrlBox" Text="https://wordpress.org" Width="380" KeyDown="UrlBox_KeyDown" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                    <Button x:Name="CheckButton" Classes="accent" Content="{l:T 'Analysieren'}" Click="Check_Click" />
                    <Button Content="{l:T 'Kopieren'}" Click="Copy_Click" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="2">
            <StackPanel>
                <Border x:Name="MainCard" Classes="Card" IsVisible="False">
                    <StackPanel>
                        <TextBlock Classes="Label" Text="{l:T 'Erkanntes System'}" />
                        <SelectableTextBlock x:Name="MainText" FontSize="28" FontWeight="SemiBold" />
                        <SelectableTextBlock x:Name="MainSub" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <DataGrid x:Name="DetectGrid" x:DataType="v:CmsRow" HeadersVisibility="Column" IsVisible="False" Margin="0,0,0,12" MaxHeight="520">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T 'Technologie'}" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="{l:T 'Kategorie'}" Binding="{Binding Category}" Width="130" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" />
                        <DataGridTextColumn Header="{l:T 'Treffsicherheit'}" Binding="{Binding Confidence}" Width="130" />
                        <DataGridTemplateColumn Header="{l:T 'Hinweise'}" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="v:CmsRow">
                                    <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Margin="12,4" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="WpOffer" Classes="Card" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="WpOfferTitle" FontWeight="SemiBold" />
                            <TextBlock x:Name="WpOfferText" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="WpButton" Classes="accent" Content="{l:T 'wp-json auswerten'}" Click="WpJson_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel x:Name="WpPanel" />
                <Border x:Name="SitemapCard" Classes="Card" IsVisible="False">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" Classes="responsive">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="SitemapTitle" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                                           Text="{l:T 'Alphabetisch sortiert – Klick öffnet den Link im Browser.'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBox x:Name="SitemapFilter" Width="220" Watermark="{l:T 'Filtern …'}" TextChanged="SitemapFilter_TextChanged" />
                                <Button Content="{l:T 'Links kopieren'}" Click="SitemapCopy_Click" />
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="SitemapList" x:DataType="s:SitemapLink" MaxHeight="520" Tapped="SitemapList_Tapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="s:SitemapLink">
                                    <Grid ColumnDefinitions="*,Auto" Cursor="Hand" ToolTip.Tip="{Binding Url}">
                                        <TextBlock Text="{Binding Display}" Foreground="{DynamicResource AccentTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding LastMod}" Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="SitemapCount" Foreground="{DynamicResource SubtleTextBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ResultsPanel" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</l:ToolView>
