<l:ToolView xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:l="using:NetStuff.Ui.Infrastructure"
            xmlns:c="using:NetStuff.Ui.Controls"
            xmlns:v="using:NetStuff.Ui.Views"
            x:Class="NetStuff.Ui.Views.WlanView">
    <Grid RowDefinitions="Auto,Auto,Auto,5*,Auto,4*">
        <StackPanel>
            <TextBlock Classes="PageTitle" Text="{l:T 'WLAN-Scanner'}" />
            <TextBlock Classes="PageSubtitle" Text="{l:T 'Alle Access Points in Reichweite mit Signalstärke, Kanal, Kanalbreite, Standard und Verschlüsselung – live als Spektrum.'}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="Card">
            <WrapPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Classes="Label" Text="{l:T 'WLAN-Adapter'}" />
                    <ComboBox x:Name="IfaceBox" Width="320" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Classes="Label" Text="Band" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Height="32">
                        <RadioButton x:Name="Band24" Content="2,4 GHz" GroupName="band" IsChecked="True" IsCheckedChanged="Band_Changed" />
                        <RadioButton x:Name="Band5" Content="5 GHz" GroupName="band" IsCheckedChanged="Band_Changed" />
                        <RadioButton x:Name="Band6" Content="6 GHz" GroupName="band" IsCheckedChanged="Band_Changed" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                    <Button x:Name="StartButton" Classes="accent" Content="{l:T 'Live-Scan starten'}" Click="Start_Click" />
                    <Button x:Name="StopButton" Content="{l:T 'Stopp'}" IsEnabled="False" Click="Stop_Click" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" x:Name="PermissionPanel" Classes="Card" IsVisible="False" BorderBrush="#D29922" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{l:T 'Standortzugriff erforderlich'}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="PermissionText" Classes="Status" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="{l:T 'Standort-Einstellungen öffnen'}" Click="OpenLocation_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Classes="Card" Padding="8">
            <c:SpectrumChart x:Name="Spectrum" MinHeight="180" />
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="2,0,0,8">
            <TextBlock x:Name="AdviceText" Classes="Status" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" x:Name="StatusText" Classes="Status" Margin="12,0,0,0" />
        </Grid>

        <DataGrid Grid.Row="5" x:Name="NetGrid" x:DataType="v:WlanRow" HeadersVisibility="Column" SelectionMode="Single"
                  CanUserSortColumns="True" SelectionChanged="NetGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="v:WlanRow">
                            <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="170" />
                <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid}" Width="170" />
                <DataGridTextColumn Header="{l:T 'Hersteller'}" Binding="{Binding Vendor}" Width="150" />
                <DataGridTextColumn Header="Signal" Binding="{Binding RssiText}" SortMemberPath="Rssi" Width="90" />
                <DataGridTemplateColumn Header="{l:T 'Qualität'}" Width="100" SortMemberPath="Quality">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="v:WlanRow">
                            <ProgressBar Value="{ReflectionBinding Quality}" Maximum="100" Height="6" MinWidth="0" Margin="12,0" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:T 'Kanal'}" Binding="{ReflectionBinding Channel}" Width="85" />
                <DataGridTextColumn Header="{l:T 'Breite'}" Binding="{Binding WidthText}" SortMemberPath="Width" Width="90" />
                <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="85" />
                <DataGridTextColumn Header="Standard" Binding="{Binding Standard}" Width="125" />
                <DataGridTextColumn Header="{l:T 'Sicherheit'}" Binding="{Binding Security}" Width="170" />
                <DataGridTextColumn Header="{l:T 'Basisrate'}" Binding="{Binding RateText}" Width="100" />
                <DataGridTextColumn Header="" Binding="{Binding ConnectedText}" Width="260" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</l:ToolView>
