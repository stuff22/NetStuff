<l:ToolView xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:l="using:NetStuff.Ui.Infrastructure"
            xmlns:s="using:NetStuff.Services"
            xmlns:c="using:NetStuff.Ui.Controls"
            x:Class="NetStuff.Ui.Views.MonitorView">
    <Grid RowDefinitions="Auto,Auto,Auto,3*,Auto,2*">
        <StackPanel>
            <TextBlock Classes="PageTitle" Text="{l:T 'Überwachung'}" />
            <TextBlock Classes="PageSubtitle" Text="{l:T 'Prüft Hosts und Dienste dauerhaft im Hintergrund (Ping, TCP-Port, HTTP, DNS, TLS-Zertifikat) und meldet Ausfälle als Mitteilung – auch wenn ein anderes Werkzeug geöffnet ist.'}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="Card">
            <WrapPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="Name" />
                    <TextBox x:Name="NameInput" Width="170" PlaceholderText="{l:T 'z. B. Firewall'}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="{l:T 'Typ'}" />
                    <ComboBox x:Name="TypeBox" Width="120" SelectedIndex="0" SelectionChanged="TypeBox_SelectionChanged">
                        <ComboBoxItem Content="Ping" />
                        <ComboBoxItem Content="TCP" />
                        <ComboBoxItem Content="HTTP" />
                        <ComboBoxItem Content="DNS" />
                        <ComboBoxItem Content="TLS" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="{l:T 'Ziel (Host, IP oder URL)'}" />
                    <TextBox x:Name="TargetBox" Width="240" KeyDown="TargetBox_KeyDown" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8" x:Name="PortPanel" IsVisible="False">
                    <TextBlock Classes="Label" Text="Port" />
                    <NumericUpDown x:Name="PortBox" Value="443" Minimum="1" Maximum="65535" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="{l:T 'Intervall (s)'}" />
                    <NumericUpDown x:Name="IntervalBox" Value="30" Minimum="5" Maximum="3600" Increment="5" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="{l:T 'Alarm nach Fehlern'}" />
                    <NumericUpDown x:Name="ThresholdBox" Value="3" Minimum="1" Maximum="20" />
                </StackPanel>
                <Button Content="{l:T 'Hinzufügen'}" Click="Add_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartButton" Classes="accent" Content="{l:T 'Überwachung starten'}" Click="Start_Click" />
                <Button x:Name="StopButton" Content="{l:T 'Stoppen'}" Click="Stop_Click" />
                <Button Content="{l:T 'Entfernen'}" Click="Remove_Click" />
                <Button Content="{l:T 'Jetzt prüfen'}" Click="CheckNow_Click" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="StatusText" Classes="Status" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="3*,12,2*">
            <DataGrid x:Name="TargetGrid" x:DataType="s:MonitorTarget" HeadersVisibility="Column" SelectionMode="Extended"
                      SelectionChanged="TargetGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="s:MonitorTarget">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Level, Converter={x:Static l:Palette.LevelBrush}}" />
                                    <TextBlock Text="{Binding Status}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
                    <DataGridTextColumn Header="{l:T 'Typ'}" Binding="{Binding Type}" Width="70" />
                    <DataGridTextColumn Header="{l:T 'Ziel'}" Binding="{Binding Display}" Width="170" />
                    <DataGridTextColumn Header="{l:T 'Letztes Ergebnis'}" Binding="{Binding LastValue}" Width="260" />
                    <DataGridTextColumn Header="{l:T 'Verfügbarkeit'}" Binding="{Binding Availability}" Width="115" />
                    <DataGridTextColumn Header="{l:T 'Geprüft'}" Binding="{Binding LastCheck}" Width="90" />
                    <DataGridTextColumn Header="{l:T 'Seit'}" Binding="{Binding Since}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Classes="Card" Margin="0" Padding="8">
                <c:LineChart x:Name="Chart" MaxPoints="120" />
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Text="{l:T 'Ereignisprotokoll'}" FontSize="16" FontWeight="SemiBold" Margin="2,12,0,6" />
        <DataGrid Grid.Row="5" x:Name="EventGrid" x:DataType="s:MonitorEvent" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="s:MonitorEvent">
                            <TextBlock Text="{Binding Level, Converter={x:Static l:Palette.LevelGlyph}}" Foreground="{Binding Level, Converter={x:Static l:Palette.LevelBrush}}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:T 'Zeit'}" Binding="{Binding TimeText}" Width="140" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                <DataGridTextColumn Header="{l:T 'Ereignis'}" Binding="{Binding Message}" Width="*" MinWidth="200" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</l:ToolView>
