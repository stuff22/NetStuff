<l:ToolView xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:l="using:NetStuff.Ui.Infrastructure"
            xmlns:s="using:NetStuff.Services"
            x:Class="NetStuff.Ui.Views.SurveyView">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel>
            <TextBlock Classes="PageTitle" Text="{l:T 'WLAN-Ausleuchtung'}" />
            <TextBlock Classes="PageSubtitle" Text="{l:T 'Geh mit dem Laptop von Raum zu Raum und nimm jeweils einen Messpunkt auf: Signalstärke, verbundener Access Point, Kanal, Datenrate, Ping zum Gateway und optional der Durchsatz. Ergebnis als Tabelle für den Kundenbericht.'}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="Card">
            <WrapPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="{l:T 'Raum / Messpunkt'}" />
                    <TextBox x:Name="RoomBox" Width="240" PlaceholderText="{l:T 'z. B. Büro 1. OG'}" KeyDown="RoomBox_KeyDown" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="{l:T 'Notiz'}" />
                    <TextBox x:Name="NoteBox" Width="240" PlaceholderText="optional" />
                </StackPanel>
                <CheckBox x:Name="SpeedBox" Content="{l:T 'Durchsatz messen (5 s)'}" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,16,10" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8" Margin="0,0,0,8">
                    <Button x:Name="StartButton" Classes="accent" Content="{l:T 'Messpunkt aufnehmen'}" Click="Measure_Click" />
                    <Button Content="{l:T 'Entfernen'}" Click="Remove_Click" />
                    <Button x:Name="ClearButton" Content="{l:T 'Liste leeren'}" Click="Clear_Click" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Classes="Status" Margin="2,0,0,8" TextWrapping="Wrap" />

        <DataGrid Grid.Row="3" x:Name="SurveyGrid" x:DataType="s:SurveyPoint" HeadersVisibility="Column" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="s:SurveyPoint">
                            <TextBlock Text="{Binding Level, Converter={x:Static l:Palette.LevelGlyph}}" Foreground="{Binding Level, Converter={x:Static l:Palette.LevelBrush}}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:T 'Raum'}" Binding="{Binding Room}" Width="150" />
                <DataGridTextColumn Header="{l:T 'Bewertung'}" Binding="{Binding Rating}" Width="105" />
                <DataGridTextColumn Header="Signal" Binding="{Binding RssiText}" Width="90" />
                <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="130" />
                <DataGridTextColumn Header="{l:T 'Access Point (BSSID)'}" Binding="{Binding Bssid}" Width="175" />
                <DataGridTextColumn Header="{l:T 'Kanal / Band'}" Binding="{Binding Channel}" Width="185" />
                <DataGridTextColumn Header="{l:T 'Datenrate'}" Binding="{Binding Rate}" Width="185" />
                <DataGridTextColumn Header="{l:T 'Ping GW'}" Binding="{Binding Ping}" Width="95" />
                <DataGridTextColumn Header="{l:T 'Durchsatz'}" Binding="{Binding Speed}" Width="110" />
                <DataGridTextColumn Header="{l:T 'APs gleiche SSID'}" Binding="{Binding SameSsid}" Width="140" />
                <DataGridTextColumn Header="{l:T 'Zeit'}" Binding="{Binding Time}" Width="70" />
                <DataGridTextColumn Header="{l:T 'Notiz'}" Binding="{Binding Note}" Width="*" MinWidth="120" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Classes="Status" Margin="2,8,0,0" TextWrapping="Wrap"
                   Text="{l:T 'Bewertung: Gut ≥ −60 dBm (alles möglich) · Mittel −60 bis −70 dBm (Surfen/Office) · Schwach −70 bis −80 dBm · Kritisch &lt; −80 dBm.'}" />
    </Grid>
</l:ToolView>
