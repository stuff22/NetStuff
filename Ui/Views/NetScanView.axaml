<l:ToolView xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:l="using:NetStuff.Ui.Infrastructure"
            xmlns:s="using:NetStuff.Services"
            x:Class="NetStuff.Ui.Views.NetScanView">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel>
            <TextBlock Classes="PageTitle" Text="{l:T 'Netzwerkscanner'}" />
            <TextBlock Classes="PageSubtitle" Text="{l:T 'Findet Geräte im lokalen Netz per ARP und Ping und ermittelt Hostname, MAC-Hersteller, Gerätetyp und offene Dienste (NetBIOS, UPnP/SSDP, Port-Check).'}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="Card">
            <WrapPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="{l:T 'Bereich (CIDR, a-b oder Einzel-IP)'}" />
                    <TextBox x:Name="RangeBox" Width="260" KeyDown="RangeBox_KeyDown" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="{l:T 'Ping-Timeout (ms)'}" />
                    <NumericUpDown x:Name="TimeoutBox" Value="700" Minimum="100" Maximum="5000" Increment="100" />
                </StackPanel>
                <CheckBox x:Name="PortsBox" Content="{l:T 'Gängige Ports prüfen (Typ-Erkennung)'}" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,16,10" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8" Margin="0,0,0,8">
                    <Button x:Name="StartButton" Classes="accent" Content="{l:T 'Scannen'}" Click="Start_Click" />
                    <Button x:Name="StopButton" Content="{l:T 'Stopp'}" IsEnabled="False" Click="Stop_Click" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <ProgressBar x:Name="Progress" Height="4" MinWidth="0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="StatusText" Classes="Status" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <DataGrid Grid.Row="3" x:Name="HostGrid" x:DataType="s:ScanHost" HeadersVisibility="Column" SelectionMode="Single"
                  CanUserSortColumns="True" DoubleTapped="HostGrid_DoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:T 'IP-Adresse'}" Binding="{Binding Ip}" SortMemberPath="SortKey" Width="125" />
                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="170" />
                <DataGridTextColumn Header="{l:T 'MAC-Adresse'}" Binding="{Binding Mac}" Width="160" />
                <DataGridTextColumn Header="{l:T 'Hersteller'}" Binding="{Binding Vendor}" Width="180" />
                <DataGridTextColumn Header="{l:T 'Typ'}" Binding="{Binding Type}" Width="170" />
                <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" SortMemberPath="PingSort" Width="80" />
                <DataGridTextColumn Header="{l:T 'Offene Ports'}" Binding="{Binding Ports}" Width="200" />
                <DataGridTextColumn Header="{l:T 'Info (UPnP / NetBIOS)'}" Binding="{Binding Info}" Width="320" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{l:T 'Port-Scan'}" Click="PortScan_Click" />
                    <MenuItem Header="Ping" Click="Ping_Click" />
                    <MenuItem Header="{l:T 'Im Browser öffnen (http)'}" Click="OpenHttp_Click" />
                    <MenuItem Header="{l:T 'Im Browser öffnen (https)'}" Click="OpenHttps_Click" />
                    <MenuItem Header="{l:T 'Wake-on-LAN-Gerät anlegen'}" Click="Wol_Click" />
                    <Separator />
                    <MenuItem Header="{l:T 'IP kopieren'}" Click="CopyIp_Click" />
                    <MenuItem Header="{l:T 'MAC kopieren'}" Click="CopyMac_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock x:Name="OuiText" Classes="Status" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{l:T 'Herstellerliste aktualisieren'}" Click="UpdateOui_Click" />
                <Button Content="{l:T 'Als CSV exportieren'}" Click="Export_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</l:ToolView>
