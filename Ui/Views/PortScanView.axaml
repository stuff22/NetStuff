<l:ToolView xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:l="using:NetStuff.Ui.Infrastructure"
            xmlns:s="using:NetStuff.Services"
            x:Class="NetStuff.Ui.Views.PortScanView">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <StackPanel>
            <TextBlock Classes="PageTitle" Text="{l:T 'Port-Scanner'}" />
            <TextBlock Classes="PageSubtitle" Text="{l:T 'TCP-Connect-Scan mit Dienst-Erkennung und Banner. Bitte nur eigene oder freigegebene Systeme scannen.'}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="Card">
            <StackPanel Spacing="10">
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Classes="Label" Text="{l:T 'Host'}" />
                        <TextBox x:Name="HostBox" Width="260" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Classes="Label" Text="{l:T 'Vorlage'}" />
                        <ComboBox x:Name="PresetBox" Width="190" SelectedIndex="0">
                            <ComboBoxItem Content="Top 100" />
                            <ComboBoxItem Content="{l:T 'Bekannte Dienste'}" />
                            <ComboBoxItem Content="1–1024" />
                            <ComboBoxItem Content="{l:T 'Alle (1–65535)'}" />
                            <ComboBoxItem Content="{l:T 'Benutzerdefiniert'}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Classes="Label" Text="{l:T 'Timeout (ms)'}" />
                        <NumericUpDown x:Name="TimeoutBox" Value="800" Minimum="100" Maximum="10000" Increment="100" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Classes="Label" Text="{l:T 'Parallel'}" />
                        <NumericUpDown x:Name="ParallelBox" Value="200" Minimum="1" Maximum="1000" Increment="10" />
                    </StackPanel>
                    <CheckBox x:Name="BannerBox" Content="{l:T 'Banner abrufen'}" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,16,2" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                        <Button x:Name="StartButton" Classes="accent" Content="{l:T 'Scannen'}" Click="Start_Click" />
                        <Button x:Name="StopButton" Content="{l:T 'Stopp'}" IsEnabled="False" Click="Stop_Click" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel>
                    <TextBlock Classes="Label" Text="{l:T 'Ports (z. B. 22,80,443,8000-8100)'}" />
                    <TextBox x:Name="PortsBox" TextWrapping="Wrap" MaxHeight="70" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Classes="Status" />
        <ProgressBar Grid.Row="3" x:Name="Progress" Height="4" Margin="0,0,0,10" />

        <DataGrid Grid.Row="4" x:Name="ResultGrid" x:DataType="s:PortRow" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80" />
                <DataGridTextColumn Header="{l:T 'Dienst'}" Binding="{Binding Service}" Width="170" />
                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="90" />
                <DataGridTextColumn Header="{l:T 'Antwortzeit'}" Binding="{Binding Time}" Width="120" />
                <DataGridTextColumn Header="{l:T 'Banner / Antwort'}" Binding="{Binding Banner}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</l:ToolView>
