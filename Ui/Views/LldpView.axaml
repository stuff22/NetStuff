<l:ToolView xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:l="using:NetStuff.Ui.Infrastructure"
            x:Class="NetStuff.Ui.Views.LldpView">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="PageTitle" Text="LLDP / CDP" />
            <TextBlock x:Name="Subtitle" Classes="PageSubtitle" />
            <Border Classes="Card">
                <Grid ColumnDefinitions="*,Auto">
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Classes="Label" Text="{l:T 'Dauer'}" />
                            <ComboBox x:Name="DurationBox" Width="260" SelectedIndex="1">
                                <ComboBoxItem Content="{l:T '35 Sekunden (nur LLDP)'}" Tag="35" />
                                <ComboBoxItem Content="{l:T '65 Sekunden (LLDP + CDP)'}" Tag="65" />
                                <ComboBoxItem Content="{l:T '125 Sekunden (sicher)'}" Tag="125" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Classes="Status" MaxWidth="520" TextWrapping="Wrap" VerticalAlignment="Bottom"
                                   Text="{l:T 'Switches senden LLDP meist alle 30 s und CDP alle 60 s. Alternativ lassen sich die Nachbarn eines Switches im SNMP-Browser („LLDP-Nachbarn“) abfragen.'}" />
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button x:Name="StartButton" Classes="accent" Content="{l:T 'Mitschnitt starten'}" Click="Start_Click" />
                        <Button x:Name="StopButton" Content="{l:T 'Abbrechen'}" IsEnabled="False" Click="Stop_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <ProgressBar x:Name="Progress" Height="4" MinWidth="0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="StatusText" Classes="Status" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
        <ScrollViewer>
            <StackPanel x:Name="ResultsPanel" />
        </ScrollViewer>
    </DockPanel>
</l:ToolView>
