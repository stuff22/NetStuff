<l:ToolView xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:l="using:NetStuff.Ui.Infrastructure"
            xmlns:s="using:NetStuff.Services"
            x:Class="NetStuff.Ui.Views.WolView">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel>
            <TextBlock Classes="PageTitle" Text="Wake-on-LAN" />
            <TextBlock Classes="PageSubtitle" Text="{l:T 'Weckt Geräte per Magic Packet auf. Gespeicherte Geräte lassen sich mit einem Doppelklick starten.'}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="Card">
            <WrapPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="Name" />
                    <TextBox x:Name="NameBox" Width="180" PlaceholderText="{l:T 'z. B. Büro-PC'}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="{l:T 'MAC-Adresse'}" />
                    <TextBox x:Name="MacBox" Width="190" PlaceholderText="AA:BB:CC:DD:EE:FF" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="{l:T 'Ziel (Broadcast oder Host)'}" />
                    <TextBox x:Name="TargetBox" Width="190" Text="255.255.255.255" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Classes="Label" Text="Port" />
                    <NumericUpDown x:Name="PortBox" Value="9" Minimum="1" Maximum="65535" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8" Margin="0,0,0,8">
                    <Button Classes="accent" Content="{l:T 'Aufwecken'}" Click="Wake_Click" />
                    <Button Content="{l:T 'Speichern'}" Click="Save_Click" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Classes="Status" Margin="2,0,0,10" TextWrapping="Wrap" />

        <DataGrid Grid.Row="3" x:Name="DeviceGrid" x:DataType="s:WolDevice" HeadersVisibility="Column" SelectionMode="Single"
                  DoubleTapped="DeviceGrid_DoubleTapped" SelectionChanged="DeviceGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="200" />
                <DataGridTextColumn Header="{l:T 'MAC-Adresse'}" Binding="{Binding Mac}" Width="180" />
                <DataGridTextColumn Header="{l:T 'Ziel'}" Binding="{Binding Target}" Width="180" />
                <DataGridTextColumn Header="Port" Binding="{ReflectionBinding Port}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="{l:T 'Ausgewähltes aufwecken'}" Click="WakeSelected_Click" />
            <Button Content="{l:T 'Entfernen'}" Click="Remove_Click" />
        </StackPanel>
    </Grid>
</l:ToolView>
