<l:ToolView xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:l="using:NetStuff.Ui.Infrastructure"
            xmlns:s="using:NetStuff.Services"
            xmlns:c="using:NetStuff.Ui.Controls"
            x:Class="NetStuff.Ui.Views.SnmpView">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <StackPanel>
            <TextBlock Classes="PageTitle" Text="{l:T 'SNMP-Browser'}" />
            <TextBlock Classes="PageSubtitle" Text="{l:T 'Fragt Switches, Router, Drucker und Server per SNMP v1/v2c ab: Systeminfo, Ports mit Status/Geschwindigkeit/VLAN, Live-Traffic, LLDP-Nachbarn des Switches, Tonerstände und beliebige OIDs.'}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="Card">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="Label" Text="{l:T 'Gerät (IP/Host)'}" />
                        <TextBox x:Name="HostBox" Width="200" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="Label" Text="Community" />
                        <TextBox x:Name="CommunityBox" Text="public" Width="140" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="Label" Text="Version" />
                        <ComboBox x:Name="VersionBox" Width="100" SelectedIndex="0">
                            <ComboBoxItem Content="v2c" />
                            <ComboBoxItem Content="v1" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="Label" Text="Port" />
                        <NumericUpDown x:Name="PortBox" Value="161" Minimum="1" Maximum="65535" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Classes="Label" Text="{l:T 'OID für freien Walk'}" />
                        <TextBox x:Name="OidBox" Text="1.3.6.1.2.1.1" Width="200" />
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <Button x:Name="StartButton" Classes="accent" Content="{l:T 'Systeminfo'}" Click="System_Click" Margin="0,0,8,0" />
                    <Button Content="{l:T 'Ports / Schnittstellen'}" Click="Interfaces_Click" Margin="0,0,8,0" />
                    <Button Content="{l:T 'LLDP-Nachbarn'}" Click="Lldp_Click" Margin="0,0,8,0" />
                    <Button Content="{l:T 'Drucker-Verbrauchsmaterial'}" Click="Supplies_Click" Margin="0,0,8,0" />
                    <Button Content="Walk" Click="Walk_Click" Margin="0,0,8,0" />
                    <Button x:Name="StopButton" Content="{l:T 'Live-Traffic stoppen'}" Click="Stop_Click" IsEnabled="False" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Classes="Status" Margin="2,0,0,8" TextWrapping="Wrap" />

        <Grid Grid.Row="3" RowDefinitions="*,Auto">
            <ScrollViewer x:Name="ResultScroll">
                <StackPanel x:Name="ResultsPanel" />
            </ScrollViewer>

            <DataGrid x:Name="InterfaceGrid" x:DataType="s:SnmpInterface" HeadersVisibility="Column" SelectionMode="Single"
                      IsVisible="False" DoubleTapped="InterfaceGrid_DoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="70" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                    <DataGridTextColumn Header="{l:T 'Beschreibung'}" Binding="{Binding Alias}" Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    <DataGridTextColumn Header="{l:T 'Geschwindigkeit'}" Binding="{Binding Speed}" Width="140" />
                    <DataGridTextColumn Header="VLAN" Binding="{Binding Vlan}" Width="70" />
                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="160" />
                    <DataGridTextColumn Header="{l:T 'Empfangen'}" Binding="{Binding InOctets}" Width="120" />
                    <DataGridTextColumn Header="{l:T 'Gesendet'}" Binding="{Binding OutOctets}" Width="120" />
                    <DataGridTextColumn Header="{l:T 'Fehler (in)'}" Binding="{Binding Errors}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="WalkGrid" x:DataType="s:SnmpRow" HeadersVisibility="Column" IsVisible="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="OID" Binding="{Binding Oid}" Width="260" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                    <DataGridTextColumn Header="{l:T 'Typ'}" Binding="{Binding Type}" Width="120" />
                    <DataGridTextColumn Header="{l:T 'Wert'}" Binding="{Binding Value}" Width="*" MinWidth="200" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" x:Name="TrafficCard" Classes="Card" Margin="0,10,0,0" Padding="8" Height="220" IsVisible="False">
                <c:LineChart x:Name="TrafficChart" Unit="Mbit/s" ShowLoss="False" MaxPoints="90" />
            </Border>
        </Grid>
    </Grid>
</l:ToolView>
