<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Net-Stuff</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- UIKit-Scene-Lebenszyklus (Pflicht ab iOS-SDK 27). Die Scene-Konfiguration liefert Avalonia
         (AvaloniaAppDelegate → AvaloniaSceneDelegate), hier genügt das Manifest selbst. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <!-- Ohne Startbildschirm-Angabe läuft die App im Kompatibilitätsmodus (schwarze Ränder) -->
    <key>UILaunchScreen</key>
    <dict/>
    <!-- Erlaubnis-Dialog „Lokales Netzwerk“ (Ping, Scanner, SNMP, Wake-on-LAN …) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Net-Stuff prüft Geräte und Dienste in deinem lokalen Netzwerk (Ping, Netzwerkscanner, Port-Scan, SNMP, Wake-on-LAN).</string>
    <!-- Kopierte Websites, Berichte und Exporte in der Dateien-App sichtbar machen -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!-- App-Symbol (iOS/Assets.xcassets, 1024 px; iOS erzeugt alle Größen daraus) -->
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/AppIcon.appiconset</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
