<Project>
  <!-- macOS: Build-Ausgabe außerhalb des Projektordners. Liegt das Projekt auf Schreibtisch/Dokumente mit iCloud-Abgleich,
       hängt macOS den Dateien Attribute an und codesign bricht ab („resource fork, Finder information … not allowed“). -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <NetStuffBuildRoot>$(HOME)/Library/Caches/NetStuff-build/iOS/</NetStuffBuildRoot>
    <BaseIntermediateOutputPath>$(NetStuffBuildRoot)obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(NetStuffBuildRoot)bin/</BaseOutputPath>
  </PropertyGroup>
</Project>
