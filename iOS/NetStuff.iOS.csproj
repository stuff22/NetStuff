<Project Sdk="Microsoft.NET.Sdk">

  <!-- iPhone/iPad-Start der Avalonia-Oberfläche. Bauen nur am Mac (Xcode + „dotnet workload install ios“).
       Befehle für Simulator und Gerät: siehe iOS/README.md -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>NetStuff.iOS</RootNamespace>
    <AssemblyName>NetStuff</AssemblyName>
    <ApplicationId>at.itstuff.netstuff</ApplicationId>
    <ApplicationTitle>Net-Stuff</ApplicationTitle>
    <ApplicationDisplayVersion>1.1.6</ApplicationDisplayVersion>
    <ApplicationVersion>7</ApplicationVersion>
    <!-- Nur die SDK-Bibliotheken kürzen: JSON-Speicher, SNMP und Berichte arbeiten mit Reflection -->
    <MtouchLink>SdkOnly</MtouchLink>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- HttpClientHandler wie am Mac/PC über SocketsHttpHandler statt NSUrlSession: Der iOS-Handler lehnt u. a.
         MaxAutomaticRedirections < Standard ab („It's not possible to lower the max number of automatic redirections“)
         und lässt keine eigene Zertifikatsprüfung zu (SSL-, CMS- und Header-Checks brauchen beides). -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <!-- Build-Ordner nicht mitkompilieren (am Mac: *.nosync, siehe Directory.Build.props) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;obj.nosync/**;bin.nosync/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- iCloud-/Finder-Attribute vor dem Signieren entfernen (sonst: „detritus not allowed“) -->
  <Target Name="NetStuffStripXattrs" BeforeTargets="_CodesignAppBundle" Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(AppBundleDir)' != ''">
    <Exec Command="xattr -cr &quot;$(AppBundleDir)&quot;" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ui\NetStuff.Ui.csproj" />
  </ItemGroup>

</Project>
